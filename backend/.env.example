# ========================================================
# DocMind AI Backend - Production Environment Variables
# ========================================================

# Server Port (Cloud PaaS like Render/Railway sets this automatically)
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For Render / Railway / Supabase / Neon, provide the full connection string:
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Alternatively, define individual DB credentials:
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=student_db
# DB_PASSWORD=your_secure_password

# Frontend URL (For CORS and Secure Cross-Site Cookies)
# Example: https://docmind-ai.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# Security & Sessions (Generate strong 32+ character random strings)
SESSION_SECRET=your_super_secret_session_key_32chars_min
OTP_SECRET=your_super_secret_otp_encryption_key_32chars

# Google Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Automated Placement Email Alerts & OTP Service
# Option A: Brevo HTTP API (Recommended for Render Free-Tier, 300 free emails/day to ANY email)
# Get your free key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend HTTP API (3,000 free emails/month)
# RESEND_API_KEY=re_your_resend_api_key_here

# Option C: Direct Gmail SMTP (Local development & paid cloud tiers)
EMAIL_USER=harikrishnanboopalan2@gmail.com
EMAIL_PASS=bagz kbrq vwes lqqi
