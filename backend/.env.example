# ========================================================
# DocMind AI Backend - Production Environment Variables
# ========================================================

# Server Port (Cloud PaaS like Render/Railway sets this automatically)
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For Render / Railway / Supabase / Neon, provide the full connection string:
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Alternatively, define individual DB credentials:
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=student_db
# DB_PASSWORD=your_secure_password

# Frontend URL (For CORS and Secure Cross-Site Cookies)
# Example: https://docmind-ai.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# Security & Sessions (Generate strong 32+ character random strings)
SESSION_SECRET=your_super_secret_session_key_32chars_min
OTP_SECRET=your_super_secret_otp_encryption_key_32chars

# Google Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Automated Placement Email Alerts & OTP Service (Gmail App Password or SMTP)
EMAIL_USER=alerts@yourdomain.com
EMAIL_PASS=your_app_password_or_smtp_secret
